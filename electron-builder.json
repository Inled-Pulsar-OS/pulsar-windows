{
    "appId": "org.pulsar.windows",
    "productName": "Pulsar Windows",
    "executableName": "pulsar-windows",
    "directories": {
        "output": "dist"
    },
    "publish": null,
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "shortcutName": "Pulsar Windows"
    },
    "win": {
        "target": "nsis"
    },
    "linux": {
        "icon": "icons/winboat_logo.svg",
        "target": ["appimage", "deb", "tar.gz"],
        "category": "Utility",
        "artifactName": "${name}-${version}-${arch}.${ext}",
        "desktop": {
            "entry": {
                "Comment": "Ejecuta aplicaciones de Windows en Pulsar OS de forma nativa",
                "Keywords": "windows;pulsar;vm;virtualization;rdp;freerdp;remoteapp;docker;kvm;apps;",
                "MimeType": "application/x-ms-dos-executable;application/x-msdownload;application/exe;application/x-exe;application/x-msi;application/vnd.microsoft.portable-executable;"
            }
        }
    },
    "files": [
        {
            "from": "build/main",
            "to": "main",
            "filter": ["**/*"]
        },
        {
            "from": "build/renderer",
            "to": "renderer",
            "filter": ["**/*"]
        },
        {
            "from": "src/main/static",
            "to": "static",
            "filter": ["**/*"]
        },
        "!build",
        "!dist",
        "!scripts"
    ],
    "extraResources": [
        {
            "from": "./guest_server/dist",
            "to": "guest_server",
            "filter": ["**/*"]
        },
        {
            "from": "./data",
            "to": "data",
            "filter": ["**/*"]
        }
    ]
}
